<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
      <VBox id="idVbInd" core:require="{ handler: 'app/dan/testfiori/ext/controller/CustomFields' }">
            <Link id="idLinkInd"
                  core:require="{ handler: 'app/dan/testfiori/ext/controller/CustomFields' }"
                  text="{path:'rejectInd'}"
                  visible="{= %{path:'rejectInd'} !== 'X'}"
                  press="handler.onRejectIndPress" />
      <Text id="idTextInd"
            text="{path:'rejectInd'}"
            visible="{= %{path:'rejectInd'} === 'X'}" />
      </VBox>
</core:FragmentDefinition>