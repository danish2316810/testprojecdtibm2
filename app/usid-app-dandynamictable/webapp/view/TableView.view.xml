<mvc:View controllerName="usib.app.dan.usidappdandynamictable.controller.TableView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="page" title="{i18n>title}">
    <ComboBox id="idCombo" items="{dropdownModel>/ErrorTypes}" selectionChange="onSelectDropItem">
      <core:Item key="{dropdownModel>key}" text="{dropdownModel>text}"></core:Item>
    </ComboBox>

    <fb:FilterBar id="filterBar" showFilterConfiguration="true" useToolbar="true" filterBarExpanded="true"></fb:FilterBar> 
    
    
    <Table id="idDynTable" mode="SingleSelectMaster" selectionChange="onLineItemClick">
        <headerToolbar>
            <Toolbar>
              <Title text="Error Data" />
            </Toolbar>
        </headerToolbar>
    </Table>
    </Page>
</mvc:View>